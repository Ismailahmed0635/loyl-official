# Database connection string for Supabase / PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loyl_db?schema=public"

# Session JWT secret
# SECURITY (SEC-01): the app FAILS FAST when this is unset — there is no
# default. If this value was ever committed or shared, ROTATE it now and
# redeploy: every session signed with the old value stays valid until expiry.
JWT_SECRET="loyl_super_secret_jwt_key_2026_bd_market"

# Smoke scripts mint dev JWTs via scripts/test-session.mjs (they cannot mint
# Firebase ID tokens). No test-code flags exist — OTP was removed in Phase 14.

# Firebase Email/Password Auth (the app's sign-in method — see FIREBASE_SETUP.md).
# Server verification uses Google's public certs, so only FIREBASE_PROJECT_ID
# is required. A real FIREBASE_PRIVATE_KEY upgrades the Admin app to full
# credentials (optional; only needed for future admin writes).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="loyl-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-abc@loyl-app.iam.gserviceaccount.com"
# Placeholder only — real key lives in Secret Manager, never in this file.
FIREBASE_PRIVATE_KEY="PASTE_PRIVATE_KEY_FROM_FIREBASE_CONSOLE_JSON_HERE"

# Upload storage (billing screenshots + menu photos). backend/storage.ts picks
# the backend per call, in this order:
#   1. an explicit dir argument (unit tests only — always local),
#   2. STORAGE_BACKEND=local|supabase (explicit override; "supabase" without
#      credentials fails loudly rather than silently falling back),
#   3. Supabase Storage when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set,
#   4. otherwise repo-root `storage/` (ephemeral on serverless — local dev only).
# Production on Vercel MUST use Supabase Storage: the filesystem there is
# read-only outside /tmp, so a local write would 500. Buckets stay private
# (scripts/storage-smoke.mjs verifies the round trip against a live project).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BACKEND=""
# Local-only alternative to Supabase: a persistent mount for the local driver.
# Unset = repo-root `storage/`. Irrelevant once Supabase Storage is configured.
STORAGE_DIR=""

# Cloudinary image upload configuration
CLOUDINARY_CLOUD_NAME="loyl-bd"
CLOUDINARY_API_KEY="1234567890"
CLOUDINARY_API_SECRET="cloudinary_secret_key"

# Phase 12 Digital Menu — Vision key used to read a photo of a printed
# menu into editable items. Groq is preferred (fast/cheap Llama 4 Scout),
# OpenAI stays as fallback. Unset = OCR is skipped and the merchant gets the
# manual editor (a supported end state; the API answers 503
# VISION_NOT_CONFIGURED). Optional overrides for the model names.
GROQ_API_KEY=""
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"

# Super-admin password for /admin (Phase 5). Unset = admin login disabled (503).
# Use a long random value in production: sessions last 12h, failed attempts are
# rate-limited (5 per minute per IP → 429), and comparisons are timing-safe.
ADMIN_PASSWORD="change-me-to-a-long-random-password"

# Phase 7 checkout — personal receive numbers shown in the payment modal.
NEXT_PUBLIC_BKASH_NUMBER="01711-223344"
NEXT_PUBLIC_NAGAD_NUMBER="01755-667788"

# Phase 8 SEO — absolute production origin used for canonical URLs, Open Graph
# tags, robots.txt and sitemap.xml. Unset = http://localhost:3000 (dev). Set it
# once the production domain is fixed; trailing slashes are tolerated and
# stripped. Invalid values (non-http/https) fall back to localhost.
NEXT_PUBLIC_APP_URL=""

# Firebase Phone Auth (transport #2 — see FIREBASE_SETUP.md). Unset = legacy
# dev-mock / Cognito flow. Client keys are public by design; Admin creds are
# server-only and must never get a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="loyl-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-abc@loyl-app.iam.gserviceaccount.com"
# Placeholder only — real key lives in Secret Manager, never in this file.
FIREBASE_PRIVATE_KEY="PASTE_PRIVATE_KEY_FROM_FIREBASE_CONSOLE_JSON_HERE"
